 data-line=\"\"><span style=\"--shiki-dark:#F97583;--shiki-light:#CF222E\">const</span><span style=\"--shiki-dark:#79B8FF;--shiki-light:#0550AE\"> withMDX</span><span style=\"--shiki-dark:#F97583;--shiki-light:#CF222E\"> =</span><span style=\"--shiki-dark:#B392F0;--shiki-light:#8250DF\"> createMDX</span><span style=\"--shiki-dark:#E1E4E8;--shiki-light:#1F2328\">({</span></span>\n<span data-line=\"\"><span style=\"--shiki-dark:#6A737D;--shiki-light:#6E7781\">  // Add markdown plugins here, as desired</span></span>\n<span data-line=\"\"><span style=\"--shiki-dark:#E1E4E8;--shiki-light:#1F2328\">});</span></span>\n<span data-line=\"\"> </span>\n<span data-line=\"\"><span style=\"--shiki-dark:#6A737D;--shiki-light:#6E7781\">// Merge MDX config with Next.js config</span></span>\n<span data-line=\"\"><span style=\"--shiki-dark:#F97583;--shiki-light:#CF222E\">export</span><span style=\"--shiki-dark:#F97583;--shiki-light:#CF222E\"> default</span><span style=\"--shiki-dark:#B392F0;--shiki-light:#8250DF\"> withMDX</span><span style=\"--shiki-dark:#E1E4E8;--shiki-light:#953800\">(</span><span style=\"--shiki-dark:#E1E4E8;--shiki-light:#1F2328\">nextConfig</span><span style=\"--shiki-dark:#E1E4E8;--shiki-light:#953800\">)</span><span style=\"--shiki-dark:#E1E4E8;--shiki-light:#1F2328\">;</span></span></code></pre></figure>\n<p class=\"leading-relaxed [&amp;:not(:first-child)]:mt-6\">This allows <code class=\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\">.mdx</code> files to act as pages, routes, or imports in your application.</p>\n<h3 class=\"font-heading mt-8 scroll-m-28 text-xl font-semibold tracking-tight\">Handling <code class=\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\">.md</code> files</h3>\n<p class=\"leading-relaxed [&amp;:not(:first-child)]:mt-6\">By default, <code class=\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\">next/mdx</code> only compiles files with the <code class=\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\">.mdx</code> extension. To handle <code class=\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\">.md</code> files with webpack, update the <code class=\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\">extension</code> option:</p>\n<figure class=\"\" data-rehype-pretty-code-figure=\"\"><figcaption class=\"text-code-foreground [&amp;_svg]:text-code-foreground flex items-center gap-2 [&amp;_svg]:size-4 [&amp;_svg]:opacity-70\" data-rehype-pretty-code-title=\"\" data-language=\"js\" data-theme=\"github-dark github-light-default\"><svg role=\"img\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" class=\"fill-foreground\"><title>JavaScript</title><path fill=\"currentColor\" d=\"M0 0h24v24H0V0zm22.034 18.276c-.175-1.095-.888-2.015-3.003-2.873-.736-.345-1.554-.585-1.797-1.14-.091-.33-.105-.51-.046-.705.15-.646.915-.84 1.515-.66.39.12.75.42.976.9 1.034-.676 1.034-.676 1.755-1.125-.27-.42-.404-.601-.586-.78-.63-.705-1.469-1.065-2.834-1.034l-.705.089c-.676.165-1.32.525-1.71 1.005-1.14 1.291-.811 3.541.569 4.471 1.365 1.02 3.361 1.244 3.616 2.205.24 1.17-.87 1.545-1.966 1.41-.811-.18-1.26-.586-1.755-1.336l-1.83 1.051c.21.48.45.689.81 1.109 1.74 1.756 6.09 1.666 6.871-1.004.029-.09.24-.705.074-1.65l.046.067zm-8.983-7.245h-2.248c0 1.938-.009 3.864-.009 5.805 0 1.232.063 2.363-.138 2.711-.33.689-1.18.601-1.566.48-.396-.196-.597-.466-.83-.855-.063-.105-.11-.196-.127-.196l-1.825 1.125c.305.63.75 1.172 1.324 1.517.855.51 2.004.675 3.207.405.783-.226 1.458-.691 1.811-1.411.51-.93.402-2.07.397-3.346.012-2.054 0-4.109 0-6.179l.004-.056z\"></path></svg>next.config.mjs</figcaption><pre class=\"no-scrollbar min-w-0 overflow-x-auto px-4 py-3.5 outline-none has-[[data-highlighted-line]]:px-0 has-[[data-line-numbers]]:px-0 has-[[data-slot=tabs]]:p-0\" style=\"--shiki-dark:#e1e4e8;--shiki-light:#1f2328;--shiki-dark-bg:#24292e;--shiki-light-bg: