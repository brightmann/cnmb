]]:text-right\",\"children\":\"Vader Bomb\"}]]}],[\"$\",\"tr\",null,{\"className\":\"last:border-b-none m-0 border-b\",\"children\":[[\"$\",\"td\",null,{\"className\":\"px-4 py-2 text-left [&[align=center]]:text-center [&[align=right]]:text-right\",\"children\":\"Razor Ramon\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-2 text-left [&[align=center]]:text-center [&[align=right]]:text-right\",\"children\":\"Chuluota, FL\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-2 text-left [&[align=center]]:text-center [&[align=right]]:text-right\",\"children\":\"Razor's Edge\"}]]}]]}]]}]}]\n36:[\"$\",\"p\",null,{\"className\":\"leading-relaxed [&:not(:first-child)]:mt-6\",\"children\":[\"We also need to make sure inline code looks good, like if I wanted to talk about \",[\"$\",\"code\",null,{\"className\":\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\",\"children\":\"<span>\"}],\" elements or tell you the good news about \",[\"$\",\"code\",null,{\"className\":\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\",\"children\":\"@tailwindcss/typography\"}],\".\"]}]\n37:[\"$\",\"h3\",null,{\"className\":\"font-heading mt-8 scroll-m-28 text-xl font-semibold tracking-tight\",\"children\":[\"Sometimes I even use \",[\"$\",\"code\",null,{\"className\":\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\",\"children\":\"code\"}],\" in headings\"]}]\n38:[\"$\",\"p\",null,{\"className\":\"leading-relaxed [&:not(:first-child)]:mt-6\",\"children\":[\"Even though it's probably a bad idea, and historically I've had a hard time making it look good. This \",[\"$\",\"em\",null,{\"children\":\"\\\"wrap the code blocks in backticks\\\"\"}],\" trick works pretty well though really.\"]}]\n39:[\"$\",\"p\",null,{\"className\":\"leading-relaxed [&:not(:first-child)]:mt-6\",\"children\":[\"Another thing I've done in the past is put a \",[\"$\",\"code\",null,{\"className\":\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\",\"children\":\"code\"}],\" tag inside of a link, like if I wanted to tell you about the \",[\"$\",\"a\",null,{\"className\":\"font-medium underline underline-offset-4\",\"href\":\"https://github.com/tailwindcss/docs\",\"children\":[\"$\",\"code\",null,{\"className\":\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\",\"children\":\"tailwindcss/docs\"}]}],\" repository. I don't love that there is an underline below the backticks but it is absolutely not worth the madness it would require to avoid it.\"]}]\n3a:[\"$\",\"h4\",null,{\"className\":\"font-heading mt-8 scroll-m-28 text-lg font-medium tracking-tight\",\"children\":[\"We haven't used an \",[\"$\",\"code\",null,{\"className\":\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\",\"children\":\"h4\"}],\" yet\"]}]\n3b:[\"$\",\"p\",null,{\"className\":\"leading-relaxed [&:not(:first-child)]:mt-6\",\"children\":[\"But now we have. Please don't use \",[\"$\",\"code\",null,{\"className\":\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\",\"children\":\"h5\"}],\" or \",[\"$\",\"code\",null,{\"className\":\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\",\"children\":\"h6\"}],\" in your content, Medium only supports two heading levels for a reason, you animals. I honestly considered using a \",[\"$\",\"code\",null,{\"className\":\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\",\"children\":\"before\"}],\" pseudo-element to scream at you if you use an \",[\"$\",\"code\",null,{\"className\":\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\",\"children\":\"h5\"}],\" or \",[\"$\",\"code\",null,{\"className\":\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\",\"children\":\"h6\"}],\".\"]}]\n3c:[\"$\",\"p\",null,{\"className\":\"leading-relaxed [&:not(:first-child)]:mt-6\",\"children\":[\"We don't style them at all out of the box because \",[\"$\",\"code\",null,{\"className\":\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\",\"children\":\"h4\"}],\" elements are already so small that they are the same size as the body copy. What are we supposed to do with an \",[\"$\",\"code\",null,{\"className\":\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\",\"children\":\"h5\"}],\", make it \",[\"$\",\"em\",null,{\"children\":\"smaller\"}],\" than the body copy? No thanks.\"]}]\n3d:[\"$\",\"h3\",null,{\"className\":\"font-heading mt-8 scroll-m-28 text-xl font-semibold tracking-tight\",\"children\":\"We still need to think about stacked headings though.\"}]\n3e:[\"$\",\"h4\",null,{\"className\":\"font-heading mt-8 scroll-m-28 text-lg font-medium tracking-tight\",\"children\":[\"Let's make sure we don't screw that up with \",[\"$\",\"code\",null,{\"className\":\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\",\"children\":\"h4\"}],\" elements, either.\"]}]\n3f:[\"$\",\"p\",null,{\"className\":\"leading-relaxed [&:not(:first-child)]:mt-6\",\"children\":\"Phew, with any luck we have styled the headings above this text and they look pretty good.\"}]\n40:[\"$\",\"p\",null,{\"className\":\"leading-relaxed [&:not(:first-child)]:mt-6\",\"children\":\"Let's add a closing paragraph here so things end with a decently sized block of text. I can't explain why I want things to end that way but I have to assume it's because I think things will look weird or unbalanced if there is a heading too close to the end of the document.\"}]\n41:[\"$\",\"p\",null,{\"className\":\"leading-relaxed [&:not(:first-child)]:mt-6\",\"children\":\"What I've written here is probably long enough, but adding this final sentence can't hurt.\"}]\n42:[\"$\",\"h2\",null,{\"id\":\"github-flavored-markdown\",\"className\":\"font-heading mt-12 scroll-m-28 text-2xl font-medium tracking-tight first:mt-0 lg:mt-20 [&+p]:!mt-4