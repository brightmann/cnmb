className\\\":\\\"leading-relaxed [\\u0026:not(:first-child)]:mt-6\\\",\\\"children\\\":\\\"Hopefully that looks good enough to you.\\\"}]\\n4b:[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-heading mt-8 scroll-m-28 text-xl font-semibold tracking-tight\\\",\\\"children\\\":\\\"What about nested lists?\\\"}]\\n4c:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"leading-relaxed [\\u0026:not(:first-child)]:mt-6\\\",\\\"children\\\":\\\"Nested lists basically always look bad which is why editors like Medium don't even let you do it, but I guess since some of you goofballs are going to do it we have to carry the burden of at least making it work.\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"4d:[\\\"$\\\",\\\"ol\\\",null,{\\\"className\\\":\\\"my-6 ml-6 list-decimal\\\",\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"mt-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"font-medium\\\",\\\"children\\\":\\\"Nested lists are rarely a good idea.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"my-6 ml-6 list-disc\\\",\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"mt-2\\\",\\\"children\\\":\\\"You might feel like you are being really \\\\\\\"organized\\\\\\\" or something but you are just creating a gross shape on the screen that is hard to read.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"mt-2\\\",\\\"children\\\":\\\"Nested navigation in UIs is a bad idea too, keep things as flat as possible.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"mt-2\\\",\\\"children\\\":\\\"Nesting tons of folders in your source code is also not helpful.\\\"}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"mt-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"font-medium\\\",\\\"children\\\":\\\"Since we need to have more items, here's another one.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"my-6 ml-6 list-disc\\\",\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"mt-2\\\",\\\"children\\\":\\\"I'm not sure if we'll bother styling more than two levels deep.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"mt-2\\\",\\\"children\\\":\\\"Two is already too much, three is guaranteed to be a bad idea.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"mt-2\\\",\\\"children\\\":\\\"If you nest four levels deep you belong in prison.\\\"}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"mt-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"font-medium\\\",\\\"children\\\":\\\"Two items isn't really a list, three is good though.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"my-6 ml-6 list-disc\\\",\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"mt-2\\\",\\\"children\\\":\\\"Again please don't nest lists if you want people to actually read your content.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"mt-2\\\",\\\"children\\\":\\\"Nobody wants to look at this.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"mt-2\\\",\\\"children\\\":\\\"I'm upset that we even have to bother styling this.\\\"}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"4e:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"leading-relaxed [\\u0026:not(:first-child)]:mt-6\\\",\\\"children\\\":[\\\"The most annoying thing about lists in Markdown is that \\\",[\\\"$\\\",\\\"code\\\",null,{\\\"className\\\":\\\"bg-muted relative rounded-md px-[0.3rem] py-[0.1rem] font-mono outline-none\\\",\\\"children\\\":\\\"\\u003cli\\u003e\\\"}],\\\" elements aren't given a child \\\",[\\\"$\\\",\\\"code\\\",null,{\\\"className\\\":\\\"bg-mu